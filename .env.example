# -----------------------------------------------------------------------------
# Lixus — entorno local (solo valores de ejemplo, sin secretos reales)
# -----------------------------------------------------------------------------
#
# Este archivo es la plantilla de variables que usa el backend y el frontend.
# Los secretos reales van en .env y no entran al repositorio.
#
# Temas por configurar según la ruta del MVP:
# - App, servidor, frontend, API
# - PostgreSQL, pool, schema global
# - Redis
# - JWT y sesión
# - IA
# - Archivos
# - Rate limiting
# - Webhooks de pago
# -----------------------------------------------------------------------------

# App
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# PostgreSQL
DB_HOST=localhost
DB_HOST_PORT=5433
DB_PORT=5433
DB_USER=lixus
DB_PASSWORD=changeme_local
DB_NAME=platform
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=changeme_jwt_secret_do_not_use_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=60

# Fixtures / desarrollo
DEV_PASSWORD_HASH=changeme_do_not_use_in_prod

# IA (si se habilita)
AI_DEFAULT_PROVIDER=sandbox
AI_MAX_TOKENS_PER_TENANT_DAY=200000
AI_MAX_PROMPT_TOKENS=4000

# Archivos
FILES_MAX_SIZE_MB=5
FILES_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Rate limiting (valores de ejemplo)
RATE_LIMIT_LOGIN_PER_MINUTE=6
RATE_LIMIT_WRITES_PER_MINUTE=30

# Webhook de pagos (sandbox local)
PAYMENT_WEBHOOK_SECRET=changeme_payment_webhook_secret
PAYMENT_WEBHOOK_ENDPOINT=http://localhost:8000/webhooks/payments/sandbox
